# Copy to `.env` for local development: `cp .env.example .env`
# `.env` is gitignored — never commit real credentials.

# Postgres connection string.
# - Local: point at a Postgres you run yourself (see README "Local development").
# - Railway: the Postgres plugin injects DATABASE_URL automatically; you do not
#   set it by hand there. Reference it in the app service as ${{ Postgres.DATABASE_URL }}.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/secret_prayer

# TLS for the Postgres connection.
# - Leave unset on Railway's private network (…​.railway.internal) — it is plaintext.
# - Set to `require` only when connecting to Postgres over the public internet.
# PGSSLMODE=require

# Port the server listens on. Railway sets this automatically; unset locally
# defaults to 3000.
# PORT=3000

# Unguessable slug for the organizer setup page (#9, §7.5). The setup page lives
# at /setup/<this value>; any other path 404s, and only this path can create the
# single session. Keep it long and random — it is the only access control.
ORGANIZER_SETUP_PATH=change-me-to-a-long-random-slug

# Public origin used to build the QR's submission URL when request headers are
# unavailable (e.g. some server contexts). Railway serves behind a proxy that
# forwards the host, so this is usually optional. Example: https://dop.example.com
# NEXT_PUBLIC_APP_URL=
