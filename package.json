{
  "name": "day-of-prayer",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build && node scripts/prepare-standalone.mjs",
    "db:deploy": "prisma migrate deploy",
    "start": "pnpm db:deploy && HOSTNAME=0.0.0.0 node .next/standalone/server.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:validate": "prisma validate",
    "db:check": "prisma generate && tsx scripts/check-database.ts",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm prisma:validate && pnpm build",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.0",
    "@prisma/client": "7.9.0",
    "dotenv": "17.2.3",
    "next": "15.5.21",
    "pg": "8.13.1",
    "qrcode": "1.5.4",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.5",
    "@types/node": "22.10.7",
    "@types/pg": "8.20.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "eslint": "9.39.4",
    "eslint-config-next": "15.5.21",
    "prettier": "3.9.6",
    "prisma": "7.9.0",
    "tsx": "4.23.1",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  },
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "prisma"
    ]
  }
}
