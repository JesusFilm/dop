generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// The single event instance (Monday 2026-07-27). Holds the organizer-set
/// times and the unguessable setup path. Reuse later = "insert another
/// Session", not a rewrite (the #5 reusability seam).
model Session {
  id String @id @default(cuid())

  /// Human-readable event name.
  name String

  /// Unique/unguessable slug for the organizer setup page (#9).
  setupPath String @unique

  /// Fixed IANA zone "Pacific/Auckland" (DST-correct); no picker (#14). The
  /// instant fields below are stored as timestamptz (absolute UTC instants);
  /// this records the zone the organizer's wall-clock inputs were entered in
  /// so they can be re-rendered DST-correctly.
  timeZone String @default("Pacific/Auckland")

  /// Organizer-set open time; interpreted in timeZone (#14).
  opensAt DateTime @db.Timestamptz(3)

  /// Organizer-set reveal time; submissions close = reveal (one instant) (#14).
  revealAt DateTime @db.Timestamptz(3)

  /// Next-morning purge time.
  purgeAfter DateTime @db.Timestamptz(3)

  /// Null until the write-once freeze fires; set atomically (§5).
  pairingFrozenAt DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  submissions Submission[]
  groups      Group[]

  @@map("sessions")
}

/// One person's entry. Identity is this id, NOT the name (#5).
model Submission {
  id String @id @default(cuid())

  sessionId String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  /// Cookie value; unique per session (one submission per device, §6).
  deviceToken String

  /// Short, shown once at submit; bearer credential (#8).
  recoveryCode String

  /// Required (#13).
  firstName String

  /// Required (#13); partner sees the full name "First Last".
  lastName String

  /// The prayer request text.
  request String

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  /// One submission per device per session (§6).
  @@unique([sessionId, deviceToken])
  /// Recovery code restores the return view; unique within a session (#8).
  @@unique([sessionId, recoveryCode])
  @@index([sessionId])
  @@map("submissions")
}

/// A matched set of Submissions: size 2, or exactly one size-3 per session
/// when the count is odd (§4). Requests are retrievable only per-group.
model Group {
  id String @id @default(cuid())

  sessionId String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  /// Submission ids in this group: size 2, or exactly one size-3 when odd.
  memberSubmissionIds String[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([sessionId])
  @@map("groups")
}
