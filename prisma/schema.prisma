generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum GatheringPhase {
  FORMING
  ASSIGNED
}

model Gathering {
  id         String          @id
  phase      GatheringPhase @default(FORMING)
  revision   Int            @default(0)
  launchedAt DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  rooms      Room[]
  participants Participant[]
}

model Room {
  id             String        @id @default(uuid()) @db.Uuid
  gatheringId    String
  name           String        @db.VarChar(100)
  directions     String        @default("") @db.VarChar(500)
  maxCapacity    Int?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  coordinatorId  String?       @unique @db.Uuid
  coordinator    Participant?  @relation("RoomCoordinator", fields: [coordinatorId], references: [id], onDelete: SetNull)
  gathering      Gathering     @relation(fields: [gatheringId], references: [id], onDelete: Cascade)
  participants   Participant[] @relation("RoomParticipants")

  @@index([gatheringId])
}

model Participant {
  id                   String    @id @default(uuid()) @db.Uuid
  gatheringId          String
  displayName          String    @db.VarChar(100)
  sessionTokenHash     String    @unique @db.VarChar(64)
  prayerCiphertext     String?
  prayerIv             String?   @db.VarChar(24)
  prayerAuthTag        String?   @db.VarChar(24)
  roomId               String?   @db.Uuid
  joinedAt             DateTime  @default(now())
  assignedAt           DateTime?
  gathering            Gathering @relation(fields: [gatheringId], references: [id], onDelete: Cascade)
  room                  Room?     @relation("RoomParticipants", fields: [roomId], references: [id], onDelete: SetNull)
  coordinatedRoom      Room?      @relation("RoomCoordinator")

  @@index([gatheringId])
  @@index([roomId])
}
